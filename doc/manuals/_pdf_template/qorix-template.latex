\documentclass[11pt]{article}

% ---- Fonts (Carlito = metric-compatible with Calibri, matches Qorix docx) ----
\usepackage{fontspec}
\setmainfont{Carlito}

% ---- Page geometry ----
\usepackage[a4paper,margin=2.2cm,headheight=28pt,footskip=32pt]{geometry}

% ---- Color + tables ----
\usepackage{xcolor}
\usepackage{colortbl}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{calc}
\definecolor{qorixcyan}{HTML}{00FFFF}
\definecolor{qorixblue}{HTML}{3A00F5}
\definecolor{qorixgray}{HTML}{F2F2F2}

% Table header rows are colored cyan by a post-processing step (see the
% build script) that rewrites pandoc's \toprule\noalign{} sequences to
% \rowcolor{qorixcyan} -- colortbl's \rowcolor cannot be chained inside
% booktabs' own \noalign machinery via macro redefinition alone.

% ---- Header / footer on every content page ----
\usepackage{fancyhdr}
\usepackage{graphicx}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.6pt}
\fancyhead[L]{\small $configid$}
\fancyhead[C]{\small $version$}
\fancyhead[R]{\small $docdate$}
\fancyfoot[L]{\raisebox{-0.3\height}{\includegraphics[height=10pt]{$logo$}}}
\fancyfoot[C]{\small Restricted \& Confidential \textcopyright{}QORIX GmbH}
\fancyfoot[R]{\small\thepage}
\fancypagestyle{plain}{\pagestyle{fancy}}

% ---- Misc ----
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
% Keep aspect ratio on every \includegraphics by default (pandoc omits
% keepaspectratio for images given only a :width:, which otherwise
% stretches them to fill \textheight vertically).
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=qorixblue,urlcolor=qorixblue,citecolor=qorixblue,hidelinks=false}
\usepackage{enumitem}
\setlist{nosep}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\setcounter{secnumdepth}{3}

\begin{document}

% ================= COVER PAGE =================
\begin{titlepage}
\newgeometry{margin=0cm}

\begin{minipage}[t]{0.62\textwidth}
\vspace{2.2cm}
\hspace{1.6cm}
\begin{minipage}{0.85\textwidth}
{\LARGE\bfseries $title$}
\end{minipage}
\end{minipage}%
\begin{minipage}[t]{0.38\textwidth}
\vspace{0pt}
\hfill\includegraphics[width=0.9\textwidth]{$covergraphic$}
\end{minipage}

\vspace{4cm}
\hspace{1.6cm}%
\colorbox{qorixcyan}{\begin{minipage}[t][5.6cm][t]{0.3cm}\mbox{}\end{minipage}}%
\colorbox{qorixgray}{\begin{minipage}[t][5.6cm][t]{11.3cm}
\vspace{0.4cm}
\hspace{0.4cm}\begin{minipage}{10.5cm}
\textbf{Prepared By:}\\[4pt]
{\Large $preparedby$}\\[2pt]
$preparedloc$\\[16pt]
\begin{tabular}{@{}ll@{}}
CONFIG ID & : $configid$ \\
VERSION   & : $version$ \\
DATE      & : $docdate$ \\
STATUS    & : $status$ \\
\end{tabular}
\end{minipage}
\end{minipage}}
\end{titlepage}
\restoregeometry

$if(toc)$
\tableofcontents
\newpage
$endif$

$body$

\end{document}
